<Page x:Class="WinUI.DiffViewer.SampleApp.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="OnPageLoaded">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>

        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin"
                        Value="1,30,0,6" />
            </Style.Setters>
        </Style>

        <Style x:Key="SettingsCardBorderStyle"
               TargetType="Border">
            <Style.Setters>
                <Setter Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="CornerRadius"
                        Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding"
                        Value="16" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PageHeader"
                   Margin="36,24,36,0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Text="Settings" />

        <ScrollViewer Grid.Row="1"
                      Padding="36,0,36,24"
                      IsTabStop="False"
                      UseSystemFocusVisuals="False"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="Appearance &amp; behavior" />
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE790;"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="App theme" />
                            <TextBlock Text="Select which app theme to display"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="themeMode"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  SelectionChanged="OnThemeModeSelectionChanged">
                            <ComboBoxItem Content="Light"
                                          Tag="Light" />
                            <ComboBoxItem Content="Dark"
                                          Tag="Dark" />
                            <ComboBoxItem Content="Use system setting"
                                          Tag="Default" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!--  About  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                           Text="About" />
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PathIcon Data="{StaticResource GitHubIcon}"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="WinUI.DiffViewer Sample App" />
                            <TextBlock Text="A sample app to demonstrate the features available in WinUI.DiffViewer."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind Version}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="To clone this repository" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas"
                                   IsTextSelectionEnabled="True"
                                   Text="git clone https://github.com/Louis-Dittmar/WinUI.DiffViewer" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Useful links" />
                        <StackPanel Margin="-12,0,0,0"
                                    Orientation="Vertical">
                            <HyperlinkButton Content="GitHub Repo"
                                             NavigateUri="https://github.com/Louis-Dittmar/WinUI.DiffViewer" />
                            <HyperlinkButton Content="WinUI.TableView (structural inspiration)"
                                             NavigateUri="https://github.com/w-ahmad/WinUI.TableView" />
                            <HyperlinkButton Content="JetBrains intellij-community (diff engine origin)"
                                             NavigateUri="https://github.com/JetBrains/intellij-community" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

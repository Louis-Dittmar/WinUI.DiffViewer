<Page x:Class="WinUI.DiffViewer.SampleApp.Pages.ViewModesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:dv="using:WinUI.DiffViewer.Controls"
      xmlns:controls="using:WinUI.DiffViewer.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="View Modes"
                                  Description="SideBySide shows two editable panes with both line-number gutters in the middle and connector curves between them (IntelliJ's simple diff viewer). Unified shows one read-only list: deleted lines followed by inserted lines (IntelliJ's unified viewer).">
            <controls:SamplePresenter.Example>
                <dv:DiffViewer x:Name="viewer" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16">
                    <RadioButtons Header="View mode"
                                  x:Name="modeButtons"
                                  SelectionChanged="OnModeSelectionChanged">
                        <RadioButton Content="Side-by-side" />
                        <RadioButton Content="Unified" />
                    </RadioButtons>
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;dv:DiffViewer x:Name="viewer"
    ViewMode="$(ViewMode)" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="ViewMode"
                                           Value="{x:Bind viewer.ViewMode, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>

<Page x:Class="WinUI.DiffViewer.SampleApp.Pages.SyntaxHighlightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:dv="using:WinUI.DiffViewer.Controls"
      xmlns:core="using:WinUI.DiffViewer.Core"
      xmlns:controls="using:WinUI.DiffViewer.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Syntax Highlighting"
                                  Description="The unified view colors keywords, strings, comments and numbers (C#, XML, JSON — Auto detects the language from the content, IntelliJ-style token classes). The editable side-by-side panes are plain TextBoxes and stay single-colored; IntelliJ gets highlighting there for free from real editor instances.">
            <controls:SamplePresenter.Example>
                <dv:DiffViewer x:Name="viewer"
                               ViewMode="Unified" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16">
                    <ComboBox Header="Language"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{local:EnumValues Type=core:SyntaxLanguage}"
                              SelectedItem="{Binding LanguageMode, Mode=TwoWay, ElementName=viewer}" />
                    <ComboBox Header="View mode"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{local:EnumValues Type=dv:DiffViewMode}"
                              SelectedItem="{Binding ViewMode, Mode=TwoWay, ElementName=viewer}" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;dv:DiffViewer x:Name="viewer"
    ViewMode="$(ViewMode)"
    LanguageMode="$(LanguageMode)" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="ViewMode"
                                           Value="{x:Bind viewer.ViewMode, Mode=OneWay}" />
                <controls:CodeSubstitution Key="LanguageMode"
                                           Value="{x:Bind viewer.LanguageMode, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>

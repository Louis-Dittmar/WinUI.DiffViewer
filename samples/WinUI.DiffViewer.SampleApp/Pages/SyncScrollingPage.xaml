<Page x:Class="WinUI.DiffViewer.SampleApp.Pages.SyncScrollingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:dv="using:WinUI.DiffViewer.Controls"
      xmlns:controls="using:WinUI.DiffViewer.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Synchronized Scrolling"
                                  Description="The two documents have different lengths (a 40-line block exists only on the right). With synchronized scrolling the panes scroll at different speeds — mapped through the change anchors like IntelliJ's SyncScrollSupport — so corresponding blocks stay next to each other. Turn it off to scroll each pane independently.">
            <controls:SamplePresenter.Example>
                <dv:DiffViewer x:Name="viewer" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16">
                    <ToggleSwitch Header="Synchronize scrolling"
                                  IsOn="{Binding SynchronizeScrolling, Mode=TwoWay, ElementName=viewer}" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;dv:DiffViewer x:Name="viewer"
    SynchronizeScrolling="$(SynchronizeScrolling)" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="SynchronizeScrolling"
                                           Value="{x:Bind viewer.SynchronizeScrolling, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>

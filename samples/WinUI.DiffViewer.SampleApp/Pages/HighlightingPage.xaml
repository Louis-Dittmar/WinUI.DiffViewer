<Page x:Class="WinUI.DiffViewer.SampleApp.Pages.HighlightingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:dv="using:WinUI.DiffViewer.Controls"
      xmlns:core="using:WinUI.DiffViewer.Core"
      xmlns:controls="using:WinUI.DiffViewer.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Highlighting"
                                  Description="Inside changed lines the viewer can additionally highlight the changed words or characters — IntelliJ's 'Highlighting Differences' setting. Lines highlights whole lines only; None disables highlighting entirely.">
            <controls:SamplePresenter.Example>
                <dv:DiffViewer x:Name="viewer" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16">
                    <ComboBox Header="Highlighting"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{local:EnumValues Type=core:HighlightMode}"
                              SelectedItem="{Binding HighlightMode, Mode=TwoWay, ElementName=viewer}" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;dv:DiffViewer x:Name="viewer"
    HighlightMode="$(HighlightMode)" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="HighlightMode"
                                           Value="{x:Bind viewer.HighlightMode, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>

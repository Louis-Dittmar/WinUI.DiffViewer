<Page x:Class="WinUI.DiffViewer.SampleApp.Pages.LiveEditingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.DiffViewer.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:dv="using:WinUI.DiffViewer.Controls"
      xmlns:controls="using:WinUI.DiffViewer.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Live Editing"
                                  Description="In side-by-side mode both panes are real, editable text boxes. Type into either side — the edit updates OldText/NewText and the diff is re-computed live (debounced, latest-wins). Every finished recomputation raises DiffComputed. The sample shows this library's own LineComparator.cs before and after the ChunkOptimizer port.">
            <controls:SamplePresenter.Example>
                <dv:DiffViewer x:Name="viewer" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16">
                    <Button Content="Reset sample text"
                            HorizontalAlignment="Stretch"
                            Click="OnResetClicked" />
                    <TextBlock Text="DiffComputed log"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ItemsControl x:Name="eventLog"
                                  MaxWidth="240" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.CSharp>
                <x:String xml:space="preserve">
viewer.DiffComputed += (s, e) => statusBar.Text = "diff updated";
viewer.DiffFailed += (s, ex) => statusBar.Text = ex.Message;

// Edits in either pane write back to OldText/NewText:
string edited = viewer.NewText;
                </x:String>
            </controls:SamplePresenter.CSharp>
        </controls:SamplePresenter>
    </Grid>
</Page>
